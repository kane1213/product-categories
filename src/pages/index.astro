---
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="產品類別 JSON API" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📦</text></svg>" />
    <title>產品類別 API</title>
  </head>
  <body>
    <div class="container">
      <h1>📦 產品類別 API</h1>
      <p class="page-subtitle">開發時直接編輯 <code>src/content/products.json</code></p>

      <div class="info-card">
        <h2>🔌 API Endpoint</h2>
        <div class="endpoint">
          <span class="http-method method-get">GET</span>
          <span class="endpoint-path">/api/categories.json</span>
        </div>

        <h2>📄 JSON 格式</h2>
        <pre><code>{`  "categories": [
    {
      "id": "category-id",
      "name": "分類名稱",
      "icon": "🏷️",
      "products": [
        { "id": "product-id", "name": "產品名稱" }
      ]
    }
  ]
`}</code></pre>
      </div>

      <div class="info-card">
        <h2>✅ 即時測試</h2>
        <button class="btn btn-primary" onclick="fetchAndShow()">🔍 查詢 API</button>
        <pre id="api-response" class="response-block"><code>點擊上方按鈕測試 API...</code></pre>
      </div>

      <div class="info-card">
        <h2>🛠️ 開發說明</h2>
        <ul>
          <li>編輯 <code>src/content/products.json</code> 來修改分類與產品</li>
          <li>執行 <code>npm run build</code> 後部署</li>
          <li>API 會讀取 JSON 檔案並輸出 <code>application/json</code></li>
          <li>開發模式：<code>npm run dev</code> 也可測試（需 Astro 支援 .js 輸出）</li>
        </ul>
      </div>
    </div>

    <script>
      async function fetchAndShow() {
        const resp = document.getElementById('api-response');
        resp.innerHTML = '<code>載入中...</code>';
        try {
          const res = await fetch('api/categories.json');
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          resp.innerHTML = '<code>' + JSON.stringify(data, null, 2) + '</code>';
        } catch (err) {
          resp.innerHTML = '<code style="color: var(--danger)">錯誤：' + err.message + '</code>';
        }
      }
    </script>
  </body>
</html>
